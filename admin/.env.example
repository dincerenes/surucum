# Panelin bağlanacağı Supabase projesi. Mobil uygulamanın kullandığı
# projeyle AYNI olmalı.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Yayımlanabilir (publishable / anon) anahtar. Tarayıcıya inmesi normaldir:
# tek başına hiçbir kapı açmaz, yetkiyi RLS ve is_admin() belirler.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# service_role anahtarı BURAYA YAZILMAZ. Panel onu hiç kullanmıyor;
# yazılırsa RLS tamamen devre dışı kalır ve panelin tüm güvenlik modeli
# anlamsızlaşır.
